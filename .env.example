# Postgres connection string (Neon, or any Postgres). Use Neon's pooled connection string in production.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Same database, direct (non-pooled) endpoint — required by Prisma Migrate's advisory
# lock (`prisma migrate deploy`, run on every build). With Neon, this is the pooled
# host above minus "-pooler" in the hostname. Using the pooled URL for both times out
# with P1002 ("...acquire a postgres advisory lock").
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Encrypts client account access (Access tab) at rest. Generate with: openssl rand -base64 32
# Changing this after data exists makes previously saved passwords undecryptable — treat it
# like a database credential, not something to rotate casually.
CREDENTIALS_ENCRYPTION_KEY=""

# Leave RESEND_API_KEY unset in local dev — magic links print to the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="Bunyan Digital <noreply@bunyandigital.co>"

# Production only (Vercel) — reverse-proxies the app under www.bunyandigital.co/crm.
# Leave unset locally so dev stays at the plain root.
# NEXT_BASE_PATH="/crm"
