# Postgres connection string (Neon, or any Postgres). Use Neon's pooled connection string in production.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Same database, direct (non-pooled) endpoint — required by Prisma Migrate's advisory
# lock (`prisma migrate deploy`, run on every build). With Neon, this is the pooled
# host above minus "-pooler" in the hostname. Using the pooled URL for both times out
# with P1002 ("...acquire a postgres advisory lock").
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""
# In production, set this to the actual public URL the app is reached at — including
# the basePath below, e.g. "https://www.bunyandigital.co/crm" — not the app's own
# bunyandigitalcrm.netlify.app origin.
AUTH_URL="http://localhost:3000"

# Encrypts client account access (Access tab) at rest. Generate with: openssl rand -base64 32
# Changing this after data exists makes previously saved passwords undecryptable — treat it
# like a database credential, not something to rotate casually.
CREDENTIALS_ENCRYPTION_KEY=""

# Leave RESEND_API_KEY unset in local dev — magic links print to the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="Bunyan Digital <noreply@bunyandigital.co>"

# Production only (Netlify) — reverse-proxies the app under www.bunyandigital.co/crm via
# a redirect on the main website's own Netlify site (see its _redirects file), forwarding
# to this app's own bunyandigitalcrm.netlify.app origin. Leave unset locally so dev stays
# at the plain root. Must match next.config.ts's basePath exactly — note the NEXT_PUBLIC_
# prefix, required so client components (e.g. the sign-out button) can read it too.
# NEXT_PUBLIC_BASE_PATH="/crm"

# Shared secret the recurring-invoice GitHub Actions cron sends when calling
# /api/cron/generate-recurring-invoices. Generate with: openssl rand -base64 32
# Must match the CRON_SECRET GitHub repo secret and Netlify's production env var.
CRON_SECRET=""

# Shared secret for the marketing site's Netlify Form outgoing webhook
# (POST /api/webhooks/revenue-finder?token=<this value>). Generate with: openssl rand -hex 32
# Set the same value in the Netlify site env; never commit the real one.
REVENUE_FINDER_WEBHOOK_SECRET=""
