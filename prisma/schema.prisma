generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma Migrate's advisory lock needs a direct (non-pooled) connection — Neon's
  // pooled/PgBouncer endpoint runs in transaction-pooling mode, which can silently
  // hand a lock/unlock pair different underlying connections and time out (P1002).
  // DATABASE_URL stays the pooled endpoint for the app's runtime queries.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

/// Fine-grained capabilities a MEMBER can be individually granted. ADMIN always has
/// every capability regardless of this list (see hasPermission in lib/permissions.ts).
enum Permission {
  MANAGE_CLIENTS
  VIEW_REPORTS
  MANAGE_SERVICES
  MANAGE_BILLING
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum BillingType {
  MONTHLY
  ONE_OFF
}

enum JobStage {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  CREATED
  COMPLETED
  CLIENT_UPDATED
  TIME_LOGGED
  QUOTE_STATUS_CHANGE
  INVOICE_STATUS_CHANGE
  EMAIL_SENT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(MEMBER)
  permissions   Permission[] @default([])
  passwordHash  String?
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Calendly integration (My Day) — token is AES-256-GCM encrypted via src/lib/crypto.ts,
  // never stored in plaintext. calendlyUserUri is captured at connect-time and needed to
  // scope the scheduled_events lookup to just this person.
  calendlyTokenCipher String?   @db.Text
  calendlyUserUri     String?
  calendlyName        String?
  calendlyConnectedAt DateTime?

  accounts           Account[]
  sessions           Session[]
  clientMembers      ClientMember[]
  assignedJobs       Job[]           @relation("JobAssignee")
  activities         Activity[]
  timeEntries        TimeEntry[]
  createdQuotes      Quote[]
  createdInvoices    Invoice[]
  personalTasks      PersonalTask[]
  followUpsAssigned  FollowUp[]      @relation("FollowUpAssignee")
  followUpsCreated   FollowUp[]      @relation("FollowUpCreator")
  portalAssetsAdded  ClientAsset[]
  portalMessagesSent ClientMessage[]
  clientFiles        ClientFile[]
  clientProducts     ClientProduct[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id           String       @id @default(cuid())
  name         String
  companyName  String?
  logoUrl      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       ClientStatus @default(LEAD)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  services                  ClientService[]
  members                   ClientMember[]
  jobs                      Job[]
  activities                Activity[]
  quotes                    Quote[]
  invoices                  Invoice[]
  onboardingTasks           ClientOnboardingTask[]
  accessEntries             ClientAccess[]
  followUps                 FollowUp[]
  revenueFinderApplications RevenueFinderApplication[]

  // Client portal (results/campaigns/reports dashboard, brand kit, messaging) — a
  // separate login surface for the client themselves, isolated from the team's Auth.js
  // session (see src/lib/portal-auth.ts).
  portalUsers                ClientPortalUser[]
  results                    ClientResult[]
  campaigns                  ClientCampaign[]
  reports                    ClientReport[]
  assets                     ClientAsset[]
  brandKit                   ClientBrandKit?
  messages                   ClientMessage[]
  // Last time a team member viewed this client's portal messages — unread count for the
  // team is simply "messages from the client newer than this".
  portalMessagesReadByTeamAt DateTime?
  // Last time a team member viewed this client's Portal tab — unread "activity" alerts
  // (brand kit saved, asset added, access submitted) are entries newer than this.
  portalActivityReadByTeamAt DateTime?
  documents                  ClientDocument[]
  clientFiles                ClientFile[]
  products                   ClientProduct[]

  @@index([status])
}

model ClientOnboardingTask {
  id          String    @id @default(cuid())
  clientId    String
  title       String
  done        Boolean   @default(false)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// Login details for a client's own third-party accounts (marketplace, hosting, ads, etc.)
/// that we've been given access to. `secretCipher` is AES-256-GCM ciphertext, never plaintext —
/// see src/lib/crypto.ts.
model ClientAccess {
  id           String   @id @default(cuid())
  clientId     String
  label        String
  username     String?
  secretCipher String   @db.Text
  url          String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ServiceType {
  id         String   @id @default(cuid())
  name       String   @unique
  colorHex   String   @default("#E08245")
  order      Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  clientServices ClientService[]
}

model ClientService {
  id              String        @id @default(cuid())
  clientId        String
  serviceTypeId   String
  label           String?
  status          ServiceStatus @default(ACTIVE)
  billingType     BillingType   @default(MONTHLY)
  priceValue      Decimal?      @db.Decimal(10, 2)
  startDate       DateTime?
  notes           String?       @db.Text
  // Anchors the monthly billing cadence for the recurring-invoice cron — when the next
  // auto-generated invoice is due. Advanced by exactly 1 month from its own prior value
  // each time (not from "today"), so billing stays anchored to the original start date.
  nextInvoiceDate DateTime?
  // Lets a MONTHLY service be exempted from automatic billing (e.g. invoiced manually by
  // arrangement) without pausing the whole service.
  autoInvoice     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType      ServiceType       @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  jobs             Job[]
  quoteLineItems   QuoteLineItem[]
  invoiceLineItems InvoiceLineItem[]

  @@index([clientId])
}

model ClientMember {
  id       String @id @default(cuid())
  clientId String
  userId   String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

/// The board-level unit of work for a client — shown on the Kanban board and
/// table view, e.g. "eBay Management – September". Contains Tasks (a checklist
/// of the actual sub-items of work) which is where time gets logged.
model Job {
  id                String     @id @default(cuid())
  clientId          String
  clientServiceId   String?
  quoteId           String?
  invoiceId         String?
  title             String
  description       String?    @db.Text
  stage             JobStage   @default(BACKLOG)
  position          Float      @default(0)
  priority          Priority   @default(MEDIUM)
  recurrence        Recurrence @default(NONE)
  assignedToId      String?
  assignmentAckedAt DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks         Task[]
  activities    Activity[]

  @@index([clientId, stage])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([quoteId])
  @@index([invoiceId])
}

/// A checklist sub-item within a Job — the granular unit of work that time is logged against.
model Task {
  id          String    @id @default(cuid())
  jobId       String
  title       String
  description String?   @db.Text
  done        Boolean   @default(false)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([jobId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  minutes   Int
  note      String?
  workDate  DateTime @default(now())
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Activity {
  id        String       @id @default(cuid())
  clientId  String
  jobId     String?
  quoteId   String?
  invoiceId String?
  userId    String?
  type      ActivityType
  message   String       @db.Text
  createdAt DateTime     @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

/// A priced proposal sent to a client before work is agreed — can be converted into
/// an Invoice once accepted.
model Quote {
  id          String      @id @default(cuid())
  clientId    String
  number      Int         @unique @default(autoincrement())
  title       String
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  expiryDate  DateTime?
  notes       String?     @db.Text
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems  QuoteLineItem[]
  invoice    Invoice?
  activities Activity[]
  jobs       Job[]

  @@index([clientId])
}

model QuoteLineItem {
  id              String  @id @default(cuid())
  quoteId         String
  clientServiceId String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  position        Int     @default(0)

  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/// A billed amount for work delivered — optionally originates from an accepted Quote.
model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  quoteId       String?       @unique
  number        Int           @unique @default(autoincrement())
  title         String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  createdById   String?
  // True when created by the recurring-invoice cron rather than a person — lets the UI
  // distinguish system-generated invoices from manually created ones.
  autoGenerated Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote      Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems  InvoiceLineItem[]
  activities Activity[]
  jobs       Job[]

  @@index([clientId])
}

model InvoiceLineItem {
  id              String  @id @default(cuid())
  invoiceId       String
  clientServiceId String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  position        Int     @default(0)

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// A private personal to-do item on a user's My Day hub — unrelated to client Jobs.
model PersonalTask {
  id          String    @id @default(cuid())
  userId      String
  title       String
  notes       String?   @db.Text
  done        Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A reminder to follow up with a client, or a standalone reminder with no client attached.
/// assignedToId is who owns it — mirrors Job.assignedToId (nullable at the DB level so a
/// deleted user's follow-ups survive via SetNull, required at the form/zod level).
model FollowUp {
  id           String    @id @default(cuid())
  clientId     String?
  assignedToId String?
  createdById  String?
  title        String
  notes        String?   @db.Text
  dueDate      DateTime
  done         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo User?   @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([clientId])
  @@index([dueDate])
}

enum RevenueFinderStatus {
  NEW
  QUALIFIED
  NOT_QUALIFIED
  ACCESS_GRANTED
  SPRINT_RUNNING
  REVEAL_BOOKED
  COMPLETED
  CONVERTED
}

// A free "7-Day Revenue Finder" application submitted through the marketing site's Netlify
// Form and delivered here by an outgoing webhook (see /api/webhooks/revenue-finder).
model RevenueFinderApplication {
  id                  String              @id @default(cuid())
  createdAt           DateTime            @default(now())
  name                String
  role                String
  email               String
  phone               String?
  storeUrl            String
  platform            String
  market              String
  monthlySize         String
  notes               String?             @db.Text
  decisionMakerOnCall Boolean             @default(false)
  accessWithin48h     Boolean             @default(false)
  status              RevenueFinderStatus @default(NEW)
  internalNotes       String?             @db.Text
  clientId            String?
  client              Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Netlify's submission id — lets the webhook upsert so retries never duplicate.
  netlifySubmissionId String              @unique

  @@index([status])
  @@index([createdAt])
}

/**
 * ================= Client portal =================
 */

/// A named contact at the client who can sign in to their own portal — separate identity
/// from the team's User model, with its own hand-rolled session (ClientPortalSession),
/// deliberately outside Auth.js so a portal session can never satisfy a team-side
/// requireUser()/requireAdmin() check by accident.
model ClientPortalUser {
  id             String    @id @default(cuid())
  clientId       String
  name           String
  email          String    @unique
  passwordHash   String
  disabledAt     DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Last time this contact viewed the message thread — unread count on their side is
  // "messages from the team newer than this".
  messagesReadAt DateTime?

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions       ClientPortalSession[]
  messages       ClientMessage[]
  assetsAdded    ClientAsset[]
  clientFiles    ClientFile[]
  clientProducts ClientProduct[]

  @@index([clientId])
}

model ClientPortalSession {
  id           String   @id @default(cuid())
  portalUserId String
  // SHA-256 of the session token — the raw token only ever lives in the httpOnly cookie,
  // mirroring how a password is never stored in plaintext.
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  portalUser ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
}

/// A KPI/metric snapshot the team publishes for the client to see (e.g. "Revenue —
/// September 2026 — £18,400 — +12%"). Deliberately free-text value/change, not numeric
/// columns — the metrics that matter vary a lot client to client (revenue, ROAS,
/// sessions, repeat rate…).
model ClientResult {
  id        String   @id @default(cuid())
  clientId  String
  period    String
  label     String
  value     String
  change    String?
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum ClientCampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model ClientCampaign {
  id        String               @id @default(cuid())
  clientId  String
  name      String
  platform  String
  status    ClientCampaignStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  spend     Decimal?             @db.Decimal(10, 2)
  revenue   Decimal?             @db.Decimal(10, 2)
  roas      Decimal?             @db.Decimal(6, 2)
  notes     String?              @db.Text
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// A link to a report document (PDF, Google Doc/Sheet, Canva…) — this app has no binary
/// file storage, so reports are hosted wherever the team already builds them and linked
/// in, the same convention ClientAccess.url and Invoice already use for external links.
model ClientReport {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  period    String?
  url       String
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum ClientAssetKind {
  LOGO
  BRAND_FILE
  PRODUCT_PHOTO
  OTHER
}

/// A logo, brand file or product photo — either side can add one. Also URL-based (no
/// binary storage): paste a link (Google Drive, Dropbox, Canva…) rather than uploading a
/// file directly.
model ClientAsset {
  id                  String          @id @default(cuid())
  clientId            String
  kind                ClientAssetKind @default(OTHER)
  label               String
  // Wherever the content lives — an external link (Drive, Dropbox…), or, when fileId is
  // set, this app's own authenticated download route for that uploaded file.
  url                 String
  // Set only when `url` points at an uploaded file rather than an external link, so
  // deleting the asset can also delete the underlying blob.
  fileId              String?         @unique
  addedByPortal       Boolean         @default(false)
  addedByUserId       String?
  addedByPortalUserId String?
  createdAt           DateTime        @default(now())

  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  file              ClientFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  addedByUser       User?             @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  addedByPortalUser ClientPortalUser? @relation(fields: [addedByPortalUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

/// One brand kit per client — theme colours and freeform notes, editable from either
/// side (the client's own brand spec; the team can also keep it current).
model ClientBrandKit {
  id        String   @id @default(cuid())
  clientId  String   @unique
  // Up to 5 hex colours, in display order — a flexible count instead of fixed
  // primary/secondary/accent roles, since different clients want different numbers.
  colors    Json?
  notes     String?  @db.Text
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ClientMessageSender {
  TEAM
  CLIENT
}

/// A single flat message thread per client — simplest shape for "communicate with
/// them", not a multi-subject inbox. Shown on both the team's Portal tab and the
/// client's own Messages page.
model ClientMessage {
  id                 String              @id @default(cuid())
  clientId           String
  body               String              @db.Text
  senderKind         ClientMessageSender
  senderUserId       String?
  senderPortalUserId String?
  createdAt          DateTime            @default(now())

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderUser       User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderPortalUser ClientPortalUser? @relation(fields: [senderPortalUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

enum ClientDocumentKind {
  AGREEMENT
  QUESTIONNAIRE
  FORM
  OTHER
}

enum ClientDocumentStatus {
  PENDING
  COMPLETED
}

/// A document the team sends a client to act on — an agreement to sign, a Google Form
/// questionnaire to fill in. Not real e-signature capture: `url` links out to wherever
/// the document actually lives (Google Forms, a PDF, PandaDoc/DocuSign…) and the client
/// marks it COMPLETED themselves once they've done it there, or the team can mark it on
/// their behalf (e.g. signed over email instead).
model ClientDocument {
  id          String               @id @default(cuid())
  clientId    String
  title       String
  kind        ClientDocumentKind   @default(OTHER)
  url         String
  // Set when `url` points at an uploaded file — either the team's original document, or
  // the client's signed/completed copy uploaded back when they mark it done.
  fileId      String?              @unique
  notes       String?              @db.Text
  status      ClientDocumentStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  file   ClientFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

/// An uploaded file, stored in Netlify Blobs (not in Postgres) — this row is the
/// metadata + authorization record; `key` is the blob's object key in the "client-files"
/// store. Downloaded only via /api/files/[fileId], which checks the requester (team
/// member with access to this client, or a portal user of this client) before streaming
/// the blob back — the key itself is never exposed to the browser.
model ClientFile {
  id                     String   @id @default(cuid())
  clientId               String
  key                    String   @unique
  fileName               String
  contentType            String
  size                   Int
  uploadedByPortal       Boolean  @default(false)
  uploadedByUserId       String?
  uploadedByPortalUserId String?
  createdAt              DateTime @default(now())

  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedByUser       User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByPortalUser ClientPortalUser? @relation(fields: [uploadedByPortalUserId], references: [id], onDelete: SetNull)
  asset                ClientAsset?
  document             ClientDocument?

  @@index([clientId])
}

enum ClientProductCategory {
  CLOTHING
  HEALTH_BEAUTY
  ELECTRONICS
  HOME_KITCHEN
  TOYS_GAMES
  OTHER
}

enum ClientProductStatus {
  PENDING
  LISTED
  DECLINED
}

/// A product the client wants the agency to list (eBay, marketplace, etc.). Universal
/// fields (name, price, quantity, description, photos) apply to every category; the
/// category-specific ones (size, expiry date, warranty…) live in `attributes` as a flat
/// key→value map, since the fields that matter vary a lot by category — see
/// src/lib/product-categories.ts for what each category actually asks for.
model ClientProduct {
  id                  String                @id @default(cuid())
  clientId            String
  name                String
  category            ClientProductCategory @default(OTHER)
  price               Decimal?              @db.Decimal(10, 2)
  quantity            Int?
  description         String?               @db.Text
  attributes          Json?
  // Up to a few uploaded/linked photos — [{ fileId?, url, fileName? }]
  photos              Json?
  status              ClientProductStatus   @default(PENDING)
  // Team-only notes (listing progress, questions, etc.) — never shown to the client.
  notes               String?               @db.Text
  addedByPortal       Boolean               @default(false)
  addedByUserId       String?
  addedByPortalUserId String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedByUser       User?                  @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  addedByPortalUser ClientPortalUser?      @relation(fields: [addedByPortalUserId], references: [id], onDelete: SetNull)
  variants          ClientProductVariant[]

  @@index([clientId])
}

/// One option of a product that comes in more than one — a size, a colour, a bundle —
/// each with its own price/quantity/SKU. A free-text label rather than fixed
/// size/colour columns, so it fits any category without per-category variant fields.
model ClientProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String
  price     Decimal? @db.Decimal(10, 2)
  quantity  Int?
  sku       String?
  createdAt DateTime @default(now())

  product ClientProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
