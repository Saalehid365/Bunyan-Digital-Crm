generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma Migrate's advisory lock needs a direct (non-pooled) connection — Neon's
  // pooled/PgBouncer endpoint runs in transaction-pooling mode, which can silently
  // hand a lock/unlock pair different underlying connections and time out (P1002).
  // DATABASE_URL stays the pooled endpoint for the app's runtime queries.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

/// Fine-grained capabilities a MEMBER can be individually granted. ADMIN always has
/// every capability regardless of this list (see hasPermission in lib/permissions.ts).
enum Permission {
  MANAGE_CLIENTS
  VIEW_REPORTS
  MANAGE_SERVICES
  MANAGE_BILLING
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum BillingType {
  MONTHLY
  ONE_OFF
}

enum JobStage {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  CREATED
  COMPLETED
  CLIENT_UPDATED
  TIME_LOGGED
  QUOTE_STATUS_CHANGE
  INVOICE_STATUS_CHANGE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(MEMBER)
  permissions   Permission[] @default([])
  passwordHash  String?
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Calendly integration (My Day) — token is AES-256-GCM encrypted via src/lib/crypto.ts,
  // never stored in plaintext. calendlyUserUri is captured at connect-time and needed to
  // scope the scheduled_events lookup to just this person.
  calendlyTokenCipher String?   @db.Text
  calendlyUserUri     String?
  calendlyName        String?
  calendlyConnectedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  clientMembers     ClientMember[]
  assignedJobs      Job[]          @relation("JobAssignee")
  activities        Activity[]
  timeEntries       TimeEntry[]
  createdQuotes     Quote[]
  createdInvoices   Invoice[]
  personalTasks     PersonalTask[]
  followUpsAssigned FollowUp[]     @relation("FollowUpAssignee")
  followUpsCreated  FollowUp[]     @relation("FollowUpCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id           String       @id @default(cuid())
  name         String
  companyName  String?
  logoUrl      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       ClientStatus @default(LEAD)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  services        ClientService[]
  members         ClientMember[]
  jobs            Job[]
  activities      Activity[]
  quotes          Quote[]
  invoices        Invoice[]
  onboardingTasks ClientOnboardingTask[]
  accessEntries   ClientAccess[]
  followUps       FollowUp[]

  @@index([status])
}

model ClientOnboardingTask {
  id          String    @id @default(cuid())
  clientId    String
  title       String
  done        Boolean   @default(false)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// Login details for a client's own third-party accounts (marketplace, hosting, ads, etc.)
/// that we've been given access to. `secretCipher` is AES-256-GCM ciphertext, never plaintext —
/// see src/lib/crypto.ts.
model ClientAccess {
  id           String   @id @default(cuid())
  clientId     String
  label        String
  username     String?
  secretCipher String   @db.Text
  url          String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ServiceType {
  id         String   @id @default(cuid())
  name       String   @unique
  colorHex   String   @default("#E08245")
  order      Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  clientServices ClientService[]
}

model ClientService {
  id            String        @id @default(cuid())
  clientId      String
  serviceTypeId String
  label         String?
  status        ServiceStatus @default(ACTIVE)
  billingType   BillingType   @default(MONTHLY)
  priceValue    Decimal?      @db.Decimal(10, 2)
  startDate     DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType      ServiceType       @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  jobs             Job[]
  quoteLineItems   QuoteLineItem[]
  invoiceLineItems InvoiceLineItem[]

  @@index([clientId])
}

model ClientMember {
  id       String @id @default(cuid())
  clientId String
  userId   String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

/// The board-level unit of work for a client — shown on the Kanban board and
/// table view, e.g. "eBay Management – September". Contains Tasks (a checklist
/// of the actual sub-items of work) which is where time gets logged.
model Job {
  id              String     @id @default(cuid())
  clientId        String
  clientServiceId String?
  quoteId         String?
  invoiceId       String?
  title           String
  description     String?    @db.Text
  stage           JobStage   @default(BACKLOG)
  position        Float      @default(0)
  priority        Priority   @default(MEDIUM)
  recurrence      Recurrence @default(NONE)
  assignedToId    String?
  assignmentAckedAt DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks         Task[]
  activities    Activity[]

  @@index([clientId, stage])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([quoteId])
  @@index([invoiceId])
}

/// A checklist sub-item within a Job — the granular unit of work that time is logged against.
model Task {
  id          String    @id @default(cuid())
  jobId       String
  title       String
  description String?   @db.Text
  done        Boolean   @default(false)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([jobId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  minutes   Int
  note      String?
  workDate  DateTime @default(now())
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Activity {
  id        String       @id @default(cuid())
  clientId  String
  jobId     String?
  quoteId   String?
  invoiceId String?
  userId    String?
  type      ActivityType
  message   String       @db.Text
  createdAt DateTime     @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

/// A priced proposal sent to a client before work is agreed — can be converted into
/// an Invoice once accepted.
model Quote {
  id          String      @id @default(cuid())
  clientId    String
  number      Int         @unique @default(autoincrement())
  title       String
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  expiryDate  DateTime?
  notes       String?     @db.Text
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems  QuoteLineItem[]
  invoice    Invoice?
  activities Activity[]
  jobs       Job[]

  @@index([clientId])
}

model QuoteLineItem {
  id              String  @id @default(cuid())
  quoteId         String
  clientServiceId String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  position        Int     @default(0)

  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/// A billed amount for work delivered — optionally originates from an accepted Quote.
model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  quoteId     String?       @unique
  number      Int           @unique @default(autoincrement())
  title       String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?       @db.Text
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote      Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems  InvoiceLineItem[]
  activities Activity[]
  jobs       Job[]

  @@index([clientId])
}

model InvoiceLineItem {
  id              String  @id @default(cuid())
  invoiceId       String
  clientServiceId String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  position        Int     @default(0)

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// A private personal to-do item on a user's My Day hub — unrelated to client Jobs.
model PersonalTask {
  id          String    @id @default(cuid())
  userId      String
  title       String
  notes       String?   @db.Text
  done        Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A reminder to follow up with a client, or a standalone reminder with no client attached.
/// assignedToId is who owns it — mirrors Job.assignedToId (nullable at the DB level so a
/// deleted user's follow-ups survive via SetNull, required at the form/zod level).
model FollowUp {
  id           String    @id @default(cuid())
  clientId     String?
  assignedToId String?
  createdById  String?
  title        String
  notes        String?   @db.Text
  dueDate      DateTime
  done         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo User?   @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([clientId])
  @@index([dueDate])
}
