generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum JobStage {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  CREATED
  COMPLETED
  CLIENT_UPDATED
  TIME_LOGGED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  passwordHash  String?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  clientMembers ClientMember[]
  assignedJobs  Job[]          @relation("JobAssignee")
  activities    Activity[]
  timeEntries   TimeEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id           String       @id @default(cuid())
  name         String
  companyName  String?
  logoUrl      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       ClientStatus @default(LEAD)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  services   ClientService[]
  members    ClientMember[]
  jobs       Job[]
  activities Activity[]

  @@index([status])
}

model ServiceType {
  id         String   @id @default(cuid())
  name       String   @unique
  colorHex   String   @default("#E08245")
  order      Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  clientServices ClientService[]
}

model ClientService {
  id            String        @id @default(cuid())
  clientId      String
  serviceTypeId String
  label         String?
  status        ServiceStatus @default(ACTIVE)
  monthlyValue  Decimal?      @db.Decimal(10, 2)
  startDate     DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  jobs        Job[]

  @@index([clientId])
}

model ClientMember {
  id       String @id @default(cuid())
  clientId String
  userId   String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

/// The board-level unit of work for a client — shown on the Kanban board and
/// table view, e.g. "eBay Management – September". Contains Tasks (a checklist
/// of the actual sub-items of work) which is where time gets logged.
model Job {
  id              String    @id @default(cuid())
  clientId        String
  clientServiceId String?
  title           String
  description     String?   @db.Text
  stage           JobStage  @default(BACKLOG)
  position        Float     @default(0)
  priority        Priority  @default(MEDIUM)
  assignedToId    String?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  tasks         Task[]
  activities    Activity[]

  @@index([clientId, stage])
  @@index([assignedToId])
  @@index([dueDate])
}

/// A checklist sub-item within a Job — the granular unit of work that time is logged against.
model Task {
  id          String    @id @default(cuid())
  jobId       String
  title       String
  done        Boolean   @default(false)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([jobId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  minutes   Int
  note      String?
  workDate  DateTime @default(now())
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Activity {
  id        String       @id @default(cuid())
  clientId  String
  jobId     String?
  userId    String?
  type      ActivityType
  message   String       @db.Text
  createdAt DateTime     @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job    Job?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}
